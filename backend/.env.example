# Database
DATABASE_URL="mysql://user:password@localhost:3306/nexious-api?allowPublicKeyRetrieval=true"

# Authentication
JWT_SECRET="change-me-to-a-random-string-at-least-32-chars"

# Super Admin (auto-seeded on first boot when all three are set)
SUPER_ADMIN_USERNAME="admin"
SUPER_ADMIN_EMAIL="admin@nexious.local"
SUPER_ADMIN_PASSWORD="change-me"

# Server
PORT=3000
